{
  "name": "Booking",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string"
    },
    "guest_email": {
      "type": "string"
    },
    "host_email": {
      "type": "string"
    },
    "check_in": {
      "type": "string"
    },
    "check_out": {
      "type": "string"
    },
    "guests": {
      "type": "number"
    },
    "nights": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "enum": [
        "LAK",
        "USD",
        "USDT"
      ],
      "default": "USD"
    },
    "guest_confirmed_completed": {
      "type": "boolean",
      "default": false
    },
    "admin_payout_approved": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "review_submitted": {
      "type": "boolean",
      "default": false
    },
    "guest_review": {
      "type": "number"
    },
    "guest_review_text": {
      "type": "string"
    }
  },
  "required": [
    "listing_id",
    "guest_email",
    "host_email",
    "check_in",
    "check_out",
    "total"
  ]
}