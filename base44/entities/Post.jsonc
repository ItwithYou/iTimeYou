{
  "name": "Post",
  "type": "object",
  "properties": {
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "culture",
        "stay",
        "food",
        "experience",
        "home",
        "nature"
      ]
    },
    "photo_url": {
      "type": "string"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "linked_listing_id": {
      "type": "string"
    },
    "likes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "like_count": {
      "type": "number",
      "default": 0
    },
    "service_type": {
      "type": "string"
    },
    "service_type_emoji": {
      "type": "string"
    },
    "service_price": {
      "type": "number"
    },
    "service_currency": {
      "type": "string",
      "enum": [
        "LAK",
        "USD",
        "USDT"
      ]
    },
    "service_duration": {
      "type": "number"
    },
    "service_duration_unit": {
      "type": "string"
    },
    "service_when": {
      "type": "string"
    },
    "service_location": {
      "type": "string"
    },
    "service_location_map_url": {
      "type": "string"
    },
    "service_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "author_email",
    "text"
  ]
}