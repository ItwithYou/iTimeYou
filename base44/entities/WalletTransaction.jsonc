    },
    "description": {
      "type": "string"
    },
    "description_lao": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "type": {
      "type": "string",
      "enum": [
        "topup",
        "withdraw",
        "payment",
        "received",
        "send"
      ]
    }
