{
  "name": "WalletTransaction",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "description_lao": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "enum": [
        "LAK",
        "USD",
        "USDT"
      ],
      "default": "USD"
    },
    "type": {
      "type": "string",
      "enum": [
        "topup",
        "withdraw",
        "payment",
        "received",
        "send"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "completed"
      ],
      "default": "pending"
    },
    "reject_reason": {
      "type": "string"
    },
    "counterparty_email": {
      "type": "string"
    },
    "payment_screenshot_url": {
      "type": "string"
    },
    "bank_name": {
      "type": "string",
      "enum": [
        "BCEL",
        "LDB"
      ]
    },
    "account_number": {
      "type": "string"
    },
    "request_kind": {
      "type": "string",
      "enum": [
        "topup",
        "withdraw",
        "send",
        "receive",
        "booking_release"
      ]
    },
    "related_booking_id": {
      "type": "string"
    },
    "account_name": {
      "type": "string"
    },
    "account_qr_url": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "amount",
    "type",
    "description"
  ]
}