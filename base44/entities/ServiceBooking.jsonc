{
  "name": "ServiceBooking",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string"
    },
    "poster_email": {
      "type": "string"
    },
    "booker_email": {
      "type": "string"
    },
    "booker_name": {
      "type": "string"
    },
    "service_type": {
      "type": "string"
    },
    "service_when": {
      "type": "string"
    },
    "service_duration": {
      "type": "number"
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "enum": [
        "LAK",
        "USD",
        "USDT"
      ]
    },
    "service_location": {
      "type": "string"
    },
    "poster_name": {
      "type": "string"
    },
    "cancel_request_status": {
      "type": "string",
      "enum": [
        "none",
        "requested",
        "approved",
        "declined"
      ],
      "default": "none"
    },
    "cancel_requested_by": {
      "type": "string"
    },
    "cancel_requested_at": {
      "type": "string"
    },
    "cancel_note": {
      "type": "string"
    },
    "cancel_resolved_by": {
      "type": "string"
    },
    "cancel_resolved_at": {
      "type": "string"
    },
    "refund_done": {
      "type": "boolean",
      "default": false
    },
    "wallet_transaction_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled",
        "completed"
      ],
      "default": "pending"
    },
    "completed_at": {
      "type": "string"
    },
    "appeal_status": {
      "type": "string",
      "enum": [
        "none",
        "submitted",
        "under_review",
        "resolved"
      ],
      "default": "none"
    },
    "appeal_submitted_by": {
      "type": "string"
    },
    "appeal_submitted_at": {
      "type": "string"
    },
    "appeal_reason": {
      "type": "string"
    },
    "appeal_resolved_by": {
      "type": "string"
    },
    "appeal_resolved_at": {
      "type": "string"
    },
    "appeal_resolution_notes": {
      "type": "string"
    }
  },
  "required": [
    "post_id",
    "poster_email",
    "booker_email",
    "price"
  ]
}